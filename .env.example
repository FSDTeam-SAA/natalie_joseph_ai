# =============================================================================
# Meet Elysia — AI Companion Engine
# Environment variable template
#
# Copy to .env and fill in real values. NEVER commit the real .env file.
#
# Deployment secrets and provider-owned IDs are intentionally blank.
# =============================================================================

# --- App -----------------------------------------------------------------
APP_ENV=development
APP_NAME=meet-elysia-ai
LOG_LEVEL=INFO

# --- Companion catalogue ---------------------------------------------------
# Public companion-profile source used by GET /api/v1/companions routes.
COMPANION_CATALOGUE_BASE_URL=https://natalieapi.duckdns.org/api/v1
COMPANION_CATALOGUE_TIMEOUT_SECONDS=15

# --- Database --------------------------------------------------------------
# Local development Postgres (Docker Compose overrides the hostname to `postgres`):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meet_elysia
# Supabase — direct connection (recommended for this service; use this
# for both the app and Alembic migrations):
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_SSL_MODE=require
#   DATABASE_DISABLE_STATEMENT_CACHE=false
#
# Supabase — transaction-mode pooler (port 6543), only if you specifically
# need pooled connections (e.g. serverless deploy with many short-lived
# connections). Requires disabling asyncpg's prepared statement cache:
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_SSL_MODE=require
#   DATABASE_DISABLE_STATEMENT_CACHE=true
#
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_SSL_MODE=prefer
DATABASE_DISABLE_STATEMENT_CACHE=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- xAI conversation model ---------------------------------------------------
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_REASONING_EFFORT=low
# Preferred image provider. If unavailable or a request fails, the configured
# OpenAI image model is used automatically.
XAI_IMAGE_MODEL=grok-imagine-image-2.0
CHAT_MAX_OUTPUT_TOKENS=800
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=2

# --- OpenAI credentials ------------------------------------------------------
OPENAI_API_KEY=
# Used automatically for user-facing chat if xAI is missing or unavailable.
OPENAI_CHAT_MODEL=gpt-5.6-terra

# --- OpenAI model configuration ----------------------------------------------
# Memory extraction     -> GPT-5.6 Luna
# Conversation summary  -> GPT-5.6 Luna
# Emotion/context       -> GPT-5.6 Luna
# Evaluation            -> GPT-5.6 Sol
OPENAI_BACKGROUND_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Auth --------------------------------------------------------------------
# Recommended boundary: the main backend owns user auth, profile, access,
# subscription/credits and forwards trusted decisions to this private service.
AUTH_MODE=internal_service_token
INTERNAL_SERVICE_TOKEN=
BACKEND_COMPANION_ID_MAP={}

# Optional direct-JWT mode (only use when all configured claims really exist):
JWT_ALGORITHM=HS256
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_USER_ID_CLAIM=id
JWT_ADULT_ELIGIBLE_CLAIM=adult_eligible
JWT_ENTITLED_CLAIM=entitled
JWT_AI_FEATURES_CLAIM=ai_features
JWT_REQUIRE_EXP=true

# Local development mode only:
LOCAL_API_KEY=dev-test-key-12345
# Deployment-owned media identity mappings; values are examples of JSON shape only.
COMPANION_VOICE_ID_MAP={}
# Optional local reference photos for image generation. Paths are relative to
# COMPANION_ASSET_ROOT and override remote catalogue image URLs when present.
# Example: {"luna":["luna/reference-1.jpg"]}
COMPANION_REFERENCE_IMAGE_MAP={}

# When AUTH_MODE=internal_service_token, the trusted backend sends:
#   Authorization: Bearer <INTERNAL_SERVICE_TOKEN>
#   X-Backend-User-Id: <uuid>
#   X-Backend-Adult-Eligible: true|false
#   X-Backend-Entitled: true|false
#   X-Backend-AI-Features: chat,voice_input,voice_output,image,proactive,story_context

# --- ElevenLabs voice ---------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ENABLE_VOICE_GENERATION=false
ENABLE_VOICE_INPUT=false
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=300
MAX_TRANSCRIPT_CHARACTERS=4000
MAX_TTS_CHARACTERS=4000

# --- Memory / context tuning ---------------------------------------------------
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.75
MEMORY_MIN_CONFIDENCE=0.6
RECENT_MESSAGE_LIMIT=20
SUMMARY_TRIGGER_MESSAGE_COUNT=30
SUMMARY_MAX_OUTPUT_TOKENS=600
RELATIONSHIP_FAMILIAR_AFTER_MESSAGES=20
RELATIONSHIP_ESTABLISHED_AFTER_MESSAGES=100
RELATIONSHIP_DEEP_AFTER_MESSAGES=200
# --- Feature flags -----------------------------------------------------------
ENABLE_IMAGE_GENERATION=false
IMAGE_OUTPUT_SIZE=1024x1536
IMAGE_OUTPUT_QUALITY=medium
MAX_REFERENCE_IMAGE_BYTES=20971520
COMPANION_ASSET_ROOT=config/companion_assets
# HTTPS hosts trusted for reference images supplied by the companion catalogue.
COMPANION_REFERENCE_IMAGE_ALLOWED_HOSTS=["res.cloudinary.com"]

# Set MEDIA_STORAGE_BACKEND=cloudinary to return permanent public Cloudinary
# URLs for generated images and audio. Keep these credentials server-only.
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_ROOT=storage/media
MEDIA_URL_PREFIX=/api/v1/media
MAX_GENERATED_MEDIA_BYTES=26214400
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=meet-elysia

# --- Rate limiting -------------------------------------------------------------
ENABLE_RATE_LIMITING=true
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_PER_USER_PER_MINUTE=20
RATE_LIMIT_PER_IP_PER_MINUTE=60
RATE_LIMIT_CONVERSATION_BURST=5

# --- Prompt versioning ---------------------------------------------------------
PROMPT_VERSION=elysia-v1
